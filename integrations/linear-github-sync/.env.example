# One GitHub repository and one Linear team, no global permissions.
GITHUB_REPO=your-org/your-repo
GITHUB_TOKEN=ghp_your_scoped_token
LINEAR_TEAM_ID=your_linear_team_uuid
LINEAR_API_KEY=lin_api_your_token
GITHUB_WEBHOOK_SECRET=replace_with_independent_random_secret
LINEAR_WEBHOOK_SECRET=replace_with_another_random_secret
# For status synchronization; require IDs from your Linear team workflow:
LINEAR_DONE_STATE_ID=
LINEAR_OPEN_STATE_ID=
SQLITE_PATH=./state/sync.sqlite
PORT=3000
DRY_RUN=true
